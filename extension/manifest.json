{
  "manifest_version": 3,
  "name": "Reelm Helper",
  "version": "1.2.0",
  "description": "Lets the Reelm website play movies: fetches the video sites from your connection and sends the headers they expect.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "*://*.hakunaymatata.com/*",
    "http://localhost/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ua",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://reelm-web.ssbeyonder.workers.dev/*",
        "http://localhost/*",
        "https://reelm-tv.vercel.app/*",
        "https://reelm-puneet-bhardwajs-projects-cfe0ba4b.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "helper@reelm.app",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "service_worker": "bg.js"
  }
}
