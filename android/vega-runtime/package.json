{
  "name": "vega-runtime",
  "private": true,
  "description": "Globals the Vega providers expect, bundled for QuickJS. Output is committed to core/media assets.",
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=iife --platform=browser --target=es2020 --legal-comments=none --outfile=../core/media/src/main/assets/vega-runtime.js"
  },
  "devDependencies": {
    "cheerio": "1.0.0-rc.12",
    "core-js": "3.39.0",
    "esbuild": "0.24.0"
  }
}
